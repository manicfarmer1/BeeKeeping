@page "/inspections"
@rendermode InteractiveServer
@using BeeKeeping.Data
@using BeeKeeping.Data.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<BeeKeepingDbContext> DbFactory

<PageTitle>Hive Inspections</PageTitle>

@if (showDeleteConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                </div>
                <div class="modal-body">
                    <p>@confirmMessage</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                    <button class="btn btn-danger" @onclick="ExecuteDelete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>🔍 Hive Inspections</h1>
    <button class="btn btn-warning" @onclick="ShowAddForm">+ Log Inspection</button>
</div>

@if (showForm)
{
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark">
            <strong>@(editingInspection.Id == 0 ? "Log Inspection" : "Edit Inspection")</strong>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Hive *</label>
                    <select class="form-select" @bind="editingInspection.HiveId">
                        <option value="0">-- Select Hive --</option>
                        @foreach (var hive in hives ?? [])
                        {
                            <option value="@hive.Id">@hive.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Inspection Date</label>
                    <input class="form-control" type="datetime-local" @bind="editingInspection.InspectionDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Inspector</label>
                    <input class="form-control" @bind="editingInspection.Inspector" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Queen Seen?</label>
                    <select class="form-select" @bind="editingInspection.QueenSeen">
                        <option>Unknown</option>
                        <option>Yes</option>
                        <option>No</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Temperament</label>
                    <select class="form-select" @bind="editingInspection.TemperamentRating">
                        <option>Calm</option>
                        <option>Moderate</option>
                        <option>Defensive</option>
                        <option>Aggressive</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Honey Stores (1-5)</label>
                    <input class="form-control" type="number" min="1" max="5" @bind="editingInspection.HoneyStoresRating" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Population (1-5)</label>
                    <input class="form-control" type="number" min="1" max="5" @bind="editingInspection.PopulationRating" />
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" @bind="editingInspection.EggsSeen" id="eggs" />
                        <label class="form-check-label" for="eggs">Eggs Seen</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" @bind="editingInspection.LarvaeSeen" id="larvae" />
                        <label class="form-check-label" for="larvae">Larvae Seen</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Brood Pattern</label>
                    <select class="form-select" @bind="editingInspection.BroodPattern">
                        <option value="">-- Select --</option>
                        <option>Solid</option>
                        <option>Spotty</option>
                        <option>No Brood</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" @bind="editingInspection.VarroaMiteCheck" id="varroa" />
                        <label class="form-check-label" for="varroa">Varroa Check</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Mite Count</label>
                    <input class="form-control" type="number" step="0.1" min="0" @bind="editingInspection.VarroaMiteCount" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Weather</label>
                    <input class="form-control" @bind="editingInspection.WeatherConditions" placeholder="e.g. Sunny, 72°F" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Treatments Applied</label>
                    <input class="form-control" @bind="editingInspection.Treatments" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Actions Taken</label>
                    <input class="form-control" @bind="editingInspection.ActionsTaken" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Next Steps</label>
                    <input class="form-control" @bind="editingInspection.NextSteps" />
                </div>
                <div class="col-12">
                    <label class="form-label">Notes</label>
                    <textarea class="form-control" @bind="editingInspection.Notes" rows="3"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-success me-2" @onclick="SaveInspection">Save</button>
                <button class="btn btn-secondary" @onclick="() => showForm = false">Cancel</button>
            </div>
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-2">@errorMessage</div>
            }
        </div>
    </div>
}

<div class="d-flex align-items-center gap-3 mb-3">
    <label class="form-label mb-0">Filter by Hive:</label>
    <select class="form-select w-auto" @bind="filterHiveId" @bind:after="FilterInspections">
        <option value="0">All Hives</option>
        @foreach (var hive in hives ?? [])
        {
            <option value="@hive.Id">@hive.Name</option>
        }
    </select>
</div>

@if (filteredInspections == null)
{
    <p>Loading...</p>
}
else if (!filteredInspections.Any())
{
    <div class="alert alert-info">No inspections recorded yet.</div>
}
else
{
    <div>
        @foreach (var inspection in filteredInspections.OrderByDescending(i => i.InspectionDate))
        {
            var isOpen = expandedIds.Contains(inspection.Id);
                var deleteMsg = "Delete inspection for " + (inspection.Hive?.Name ?? "") + " on " + inspection.InspectionDate.ToString("MMM d, yyyy") + "?";
            <div class="card mb-2">
                <div class="card-header p-0">
                    <button class="btn btn-link text-start w-100 text-decoration-none px-3 py-2"
                            @onclick="() => ToggleExpanded(inspection.Id)">
                        <span class="me-2">@(isOpen ? "▲" : "▼")</span>
                        <strong class="me-3">@inspection.Hive?.Name</strong>
                        <span class="me-3 text-muted">@inspection.InspectionDate.ToString("MMM d, yyyy h:mm tt")</span>
                        <span class="badge bg-warning text-dark me-2">👑 @inspection.QueenSeen</span>
                        <span class="badge bg-info text-dark me-2">🍯 @inspection.HoneyStoresRating/5</span>
                        <span class="badge bg-secondary">👥 @inspection.PopulationRating/5</span>
                    </button>
                </div>
                @if (isOpen)
                {
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-3"><strong>Inspector:</strong> @inspection.Inspector</div>
                            <div class="col-md-3"><strong>Temperament:</strong> @inspection.TemperamentRating</div>
                            <div class="col-md-3"><strong>Brood Pattern:</strong> @(string.IsNullOrEmpty(inspection.BroodPattern) ? "—" : inspection.BroodPattern)</div>
                            <div class="col-md-3"><strong>Weather:</strong> @(string.IsNullOrEmpty(inspection.WeatherConditions) ? "—" : inspection.WeatherConditions)</div>
                            <div class="col-md-2"><strong>Eggs:</strong> @(inspection.EggsSeen ? "✅" : "❌")</div>
                            <div class="col-md-2"><strong>Larvae:</strong> @(inspection.LarvaeSeen ? "✅" : "❌")</div>
                            <div class="col-md-4"><strong>Varroa Check:</strong> @(inspection.VarroaMiteCheck ? $"✅ Count: {inspection.VarroaMiteCount?.ToString() ?? "—"}" : "Not performed")</div>
                            @if (!string.IsNullOrEmpty(inspection.Treatments))
                            {
                                <div class="col-12"><strong>Treatments:</strong> @inspection.Treatments</div>
                            }
                            @if (!string.IsNullOrEmpty(inspection.ActionsTaken))
                            {
                                <div class="col-12"><strong>Actions Taken:</strong> @inspection.ActionsTaken</div>
                            }
                            @if (!string.IsNullOrEmpty(inspection.NextSteps))
                            {
                                <div class="col-12"><strong>Next Steps:</strong> @inspection.NextSteps</div>
                            }
                            @if (!string.IsNullOrEmpty(inspection.Notes))
                            {
                                <div class="col-12 text-muted"><strong>Notes:</strong> @inspection.Notes</div>
                            }
                        </div>
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditInspection(inspection)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => PromptDelete(inspection.Id, deleteMsg)">Delete</button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Hive>? hives;
    private List<Inspection>? inspections;
    private List<Inspection>? filteredInspections;
    private Inspection editingInspection = new();
    private bool showForm;
    private string errorMessage = string.Empty;
    private int filterHiveId = 0;
    private HashSet<int> expandedIds = new();

    private void ToggleExpanded(int id)
    {
        if (!expandedIds.Add(id))
            expandedIds.Remove(id);
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        hives = await db.Hives.Where(h => h.IsActive).OrderBy(h => h.Name).ToListAsync();
        inspections = await db.Inspections.Include(i => i.Hive).ToListAsync();
        FilterInspections();
    }

    private void FilterInspections()
    {
        filteredInspections = filterHiveId == 0
            ? inspections
            : inspections?.Where(i => i.HiveId == filterHiveId).ToList();
    }

    private void ShowAddForm()
    {
        editingInspection = new Inspection
        {
            InspectionDate = DateTime.Now,
            HoneyStoresRating = 3,
            PopulationRating = 3
        };
        errorMessage = string.Empty;
        showForm = true;
    }

    private void EditInspection(Inspection inspection)
    {
        editingInspection = new Inspection
        {
            Id = inspection.Id,
            HiveId = inspection.HiveId,
            InspectionDate = inspection.InspectionDate,
            Inspector = inspection.Inspector,
            QueenSeen = inspection.QueenSeen,
            EggsSeen = inspection.EggsSeen,
            LarvaeSeen = inspection.LarvaeSeen,
            BroodPattern = inspection.BroodPattern,
            HoneyStoresRating = inspection.HoneyStoresRating,
            PopulationRating = inspection.PopulationRating,
            TemperamentRating = inspection.TemperamentRating,
            VarroaMiteCheck = inspection.VarroaMiteCheck,
            VarroaMiteCount = inspection.VarroaMiteCount,
            Treatments = inspection.Treatments,
            ActionsTaken = inspection.ActionsTaken,
            NextSteps = inspection.NextSteps,
            Notes = inspection.Notes,
            WeatherConditions = inspection.WeatherConditions
        };
        errorMessage = string.Empty;
        showForm = true;
    }

    private async Task SaveInspection()
    {
        if (editingInspection.HiveId == 0)
        {
            errorMessage = "Please select a hive.";
            return;
        }
        await using var db = await DbFactory.CreateDbContextAsync();

        if (editingInspection.Id == 0)
        {
            db.Inspections.Add(editingInspection);
        }
        else
        {
            var existing = await db.Inspections.FindAsync(editingInspection.Id);
            if (existing != null)
            {
                existing.HiveId = editingInspection.HiveId;
                existing.InspectionDate = editingInspection.InspectionDate;
                existing.Inspector = editingInspection.Inspector;
                existing.QueenSeen = editingInspection.QueenSeen;
                existing.EggsSeen = editingInspection.EggsSeen;
                existing.LarvaeSeen = editingInspection.LarvaeSeen;
                existing.BroodPattern = editingInspection.BroodPattern;
                existing.HoneyStoresRating = editingInspection.HoneyStoresRating;
                existing.PopulationRating = editingInspection.PopulationRating;
                existing.TemperamentRating = editingInspection.TemperamentRating;
                existing.VarroaMiteCheck = editingInspection.VarroaMiteCheck;
                existing.VarroaMiteCount = editingInspection.VarroaMiteCount;
                existing.Treatments = editingInspection.Treatments;
                existing.ActionsTaken = editingInspection.ActionsTaken;
                existing.NextSteps = editingInspection.NextSteps;
                existing.Notes = editingInspection.Notes;
                existing.WeatherConditions = editingInspection.WeatherConditions;
            }
        }

        var hive = await db.Hives.FindAsync(editingInspection.HiveId);
        if (hive != null && editingInspection.QueenSeen == "Yes")
            hive.QueenStatus = "Present";
        else if (hive != null && editingInspection.QueenSeen == "No")
            hive.QueenStatus = "Queenless";

        await db.SaveChangesAsync();
        showForm = false;
        await LoadData();
    }

    private bool showDeleteConfirm;
    private string confirmMessage = string.Empty;
    private int pendingDeleteId;

    private void PromptDelete(int id, string message)
    {
        pendingDeleteId = id;
        confirmMessage = message;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteId = 0;
    }

    private async Task ExecuteDelete()
    {
        showDeleteConfirm = false;
        await DeleteInspection(pendingDeleteId);
        pendingDeleteId = 0;
    }

    private async Task DeleteInspection(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var inspection = await db.Inspections.FindAsync(id);
        if (inspection != null) { db.Inspections.Remove(inspection); await db.SaveChangesAsync(); }
        await LoadData();
    }
}

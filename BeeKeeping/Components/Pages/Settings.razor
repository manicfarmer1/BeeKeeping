@page "/settings"
@using BeeKeeping.Data.Models

<PageTitle>Settings</PageTitle>

<h1>⚙️ Settings</h1>

<div class="card" style="max-width:480px">
    <div class="card-header bg-light">
        <strong>Expense Category Tax Treatment Reference</strong>
    </div>
    <div class="card-body p-0">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr>
                    <th>Category</th>
                    <th>Treatment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in ExpenseCategories.All)
                {
                    <tr>
                        <td><span class="badge bg-secondary">@cat</span></td>
                        <td class="small text-muted">@ExpenseCategories.TaxTreatmentNote(cat)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

